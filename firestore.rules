rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return isSignedIn() &&
        request.auth.uid in
          get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
    }

    match /users/{uid} {
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
    }

    match /shareCodes/{code} {
      // Codes are short, random, and short-lived — knowing the exact code is the credential.
      allow get: if isSignedIn();

      allow create: if isMember(request.resource.data.householdId)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.expiresAt <= request.time + duration.value(30, 'm');

      // Redeeming device flips pending -> used and stamps itself.
      allow update: if isSignedIn()
                    && resource.data.status == 'pending'
                    && resource.data.expiresAt > request.time
                    && request.resource.data.status == 'used'
                    && request.resource.data.usedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'usedBy', 'usedAt']);

      allow delete: if isMember(resource.data.householdId); // owner can revoke/rotate
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);

      allow create: if isSignedIn()
                    && request.resource.data.memberUids == [request.auth.uid];

      // (a) an existing member removes one or more members (leave, or revoke a lost device)
      // (b) a new device joins by redeeming a matching, pending, unexpired code
      allow update: if
        (
          request.auth.uid in resource.data.memberUids &&
          request.resource.data.memberUids.size() < resource.data.memberUids.size() &&
          resource.data.memberUids.hasAll(request.resource.data.memberUids)
        ) ||
        (
          !(request.auth.uid in resource.data.memberUids) &&
          request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
          request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
          request.auth.uid in request.resource.data.memberUids &&
          get(/databases/$(database)/documents/shareCodes/$(request.resource.data.lastRedeemedCode)).data.householdId == householdId &&
          get(/databases/$(database)/documents/shareCodes/$(request.resource.data.lastRedeemedCode)).data.status == 'pending' &&
          get(/databases/$(database)/documents/shareCodes/$(request.resource.data.lastRedeemedCode)).data.expiresAt > request.time
        );

      allow delete: if false; // no household deletion in MVP

      match /catalog/{itemId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isMember(householdId);
      }
      match /highFrequency/{itemId} { allow read, write: if isMember(householdId); }
      match /lessFrequent/{itemId}  { allow read, write: if isMember(householdId); }

      match /thisWeek/{itemId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId) && request.resource.data.addedBy == request.auth.uid;
        allow update, delete: if isMember(householdId);
      }
    }
  }
}
